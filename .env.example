# Copy to .env and fill in real values. Never commit .env.

# Postgres connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/movie_memory?schema=public"

# Auth.js (generate with: npx auth secret)
AUTH_SECRET=""
# Needed for `next start` (production mode) when not behind a platform that
# sets the host (e.g. Vercel). Alternatively set AUTH_URL to the public URL.
AUTH_TRUST_HOST=true

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# OpenAI
OPENAI_API_KEY=""
